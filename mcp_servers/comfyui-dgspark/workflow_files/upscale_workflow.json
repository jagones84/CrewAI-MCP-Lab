{
  "1": {
    "inputs": {
      "image": "example.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Image"
    }
  },
  "10": {
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1024,
      "height": 1024,
      "crop": "center"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Image Scale to 1024"
    }
  },
  "2": {
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    },
    "class_type": "UpscaleModelLoader",
    "_meta": {
      "title": "Load Upscale Model"
    }
  },
  "3": {
    "inputs": {
      "upscale_model": [
        "2",
        0
      ],
      "image": [
        "10",
        0
      ]
    },
    "class_type": "ImageUpscaleWithModel",
    "_meta": {
      "title": "Upscale Image (with Model)"
    }
  },
  "4": {
    "inputs": {
      "filename_prefix": "ComfyUI_upscaled",
      "images": [
        "3",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
