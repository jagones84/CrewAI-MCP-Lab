# Copy this file to the repository root .env and fill in real values.
# The example loads it from the repo root via src/main.py.
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# ComfyUI endpoint reachable from the local machine.
# Use 11002 if you tunnel remote DGX-SPARK-ETH:8188 -> local 11002.
COMFYUI_SERVER_ADDRESS=127.0.0.1:11002
